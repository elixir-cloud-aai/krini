# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Chart tests (CI)
/tests/
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# Digest of the dependencies, checked in CI and on release
charts.sha256
