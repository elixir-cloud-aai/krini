# Multi-stage build for better optimization
FROM python:3.9-slim as builder

# Install build dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        git \
        curl \
        libxml2-dev \
        libxslt-dev \
        python3-dev \
        zlib1g-dev \
        libbz2-dev \
        libreadline-dev \
        libsqlite3-dev \
        libssl-dev \
        libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# Set up Python environment
WORKDIR /build

# Copy and install Python dependencies
COPY requirements.txt .
RUN pip install --upgrade pip setuptools wheel
RUN pip install --no-cache-dir -r requirements.txt

# Production stage
FROM python:3.9-slim as production

# Install runtime dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        openjdk-21-jre-headless \
        curl \
        git \
        procps \
        && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN groupadd -r appuser && useradd -r -g appuser appuser

# Set up application directory
WORKDIR /app

# Copy Python packages from builder stage
COPY --from=builder /usr/local/lib/python3.9/site-packages /usr/local/lib/python3.9/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Install Nextflow
RUN curl -s https://get.nextflow.io | bash && \
    chmod 755 nextflow && \
    mv nextflow /usr/local/bin/nextflow && \
    /usr/local/bin/nextflow -version

# Copy application code
COPY --chown=appuser:appuser . .

# Set up Nextflow home directory
ENV NXF_HOME=/app/.nextflow
RUN mkdir -p $NXF_HOME && \
    chown -R appuser:appuser $NXF_HOME && \
    chmod -R 755 $NXF_HOME

# Create necessary directories with proper permissions
RUN mkdir -p /app/uploads /app/work /app/logs && \
    chown -R appuser:appuser /app && \
    chmod -R 755 /app/uploads /app/work /app/logs

# Switch to non-root user
USER appuser

# Set environment variables
ENV FLASK_APP=main.py
ENV FLASK_RUN_HOST=0.0.0.0
ENV FLASK_RUN_PORT=8080
ENV PORT=8080
ENV HOST=0.0.0.0
ENV PYTHONPATH=/app
ENV PATH="/usr/local/bin:$PATH"

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Expose port
EXPOSE 8080

# Use the main.py as entry point for better architecture
CMD ["python", "main.py"]
